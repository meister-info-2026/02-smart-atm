# Frontend Environment Variables Template

# FastAPI 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 상담원 토큰은 화면이 ?token=... 으로 자동으로 붙인다 (여기에 적지 않는다)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# 라즈베리파이 ATM 로컬 데몬 주소 (/atm 화면이 호출한다)
# 파이의 7인치 화면에서 열 때는 localhost, 개발 PC 브라우저에서 열 때는 파이의 IP
NEXT_PUBLIC_ATM_DAEMON_URL=http://localhost:8100
