# Backend Environment Variables Template
# 실제 값은 .env에 채운다 (.env는 커밋되지 않는다 — security-rules.md)

# 장치 모드 ('mock' = 시뮬레이터, 'hardware' = 라즈베리파이 5 실기기)
DEVICE_MODE=mock

# ── MySQL (PRD 5.9) ─────────────────────────────────────────────────────────
# Cafe24 서버 내부 127.0.0.1에서만 접근한다. 3306을 외부에 열지 않는다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_atm

# 위 DB_* 대신 접속 URL을 통째로 지정하고 싶을 때만 사용한다.
# (테스트/시연 백업용 SQLite: sqlite:///./smart_atm.db)
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/smart_atm?charset=utf8mb4

# ── 인증 (api-rules.md '인증 분리') ─────────────────────────────────────────
# 사용자향: JWT. 32바이트 이상의 임의 문자열을 직접 만들어 넣는다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 디바이스향: 라즈베리파이 ATM이 X-Device-Api-Key 헤더로 보내는 키
# (pi/.env의 DEVICE_API_KEY와 같은 값이어야 한다)
DEVICE_API_KEY=

# ── 기타 ────────────────────────────────────────────────────────────────────
# 프론트엔드 주소 (쉼표로 여러 개, 배포 시에는 * 대신 실제 도메인만 남긴다)
CORS_ORIGINS=http://localhost:3000

# 시연용 seed 계정 비밀번호 (python -m db.seed 실행 시 사용)
SEED_DEFAULT_PASSWORD=
