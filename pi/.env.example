# Raspberry Pi 5 ATM 데몬 환경변수 템플릿
# 실제 값은 .env에 채운다 (.env는 커밋되지 않는다)

# 백엔드 주소
# 중요: 라즈베리파이에서 localhost는 파이 자신을 뜻한다. 백엔드가 도는 PC의
# 로컬 IP(예: http://192.168.0.25:8000)나 실제 배포 URL을 넣는다.
BACKEND_URL=http://192.168.0.100:8000

# 디바이스 인증 키 (backend/.env의 DEVICE_API_KEY와 같은 값이어야 한다)
DEVICE_API_KEY=

# 장치 모드 ('mock' = 서보 없이 로직만, 'hardware' = 실제 GPIO 제어)
DEVICE_MODE=mock

# gpiozero 핀 팩토리 (라즈베리파이 5 RP1 칩셋에는 lgpio가 필요하다)
GPIOZERO_PIN_FACTORY=lgpio

# MG996R 서보 GPIO 핀 (PRD 5.4: 실제 핀 번호는 조립 단계에서 확정한다)
SERVO_GATE_PIN=18
SERVO_PUSHER_PIN=19
# 부저는 선택 기능이다. 안 쓰면 비워 둔다.
BUZZER_PIN=

# QR 카메라
# 노트북 내장캠은 보통 0, USB 웹캠을 꽂으면 1이나 2일 수 있다
CAMERA_INDEX=0
# 카메라 없이 시연할 때는 false로 두고 POST /qr 로 session_id를 직접 넣는다
ENABLE_CAMERA=true
# OpenCV 카메라 백엔드. auto면 Windows에서 dshow를 먼저 시도한다
# (Windows 기본값 msmf는 웹캠을 여는 데 오래 걸리거나 실패하는 일이 잦다)
# 가능한 값: auto | dshow | msmf | v4l2 | any
CAMERA_BACKEND=auto

# ATM 로컬 데몬 포트 (7인치 화면이 이 주소를 호출한다)
ATM_DAEMON_PORT=8100

# 콜센터 확인 결과 폴링 주기(초)
CALL_CENTER_POLL_SECONDS=3
